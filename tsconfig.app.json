{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "writer-sync/core": ["./packages/writer-sync/src/core/index.ts"],
      "writer-sync/crypto": ["./packages/writer-sync/src/crypto/index.ts"],
      "writer-sync/operations": ["./packages/writer-sync/src/operations/index.ts"],
      "writer-sync/pairing": ["./packages/writer-sync/src/pairing/index.ts"],
      "writer-sync/providers/webrtc": [
        "./packages/writer-sync/src/providers/webrtc/index.ts"
      ],
      "writer-qr/encode": ["./packages/writer-qr/src/encode/index.ts"],
      "writer-qr/scan": ["./packages/writer-qr/src/scan/index.ts"],
      "writer-notebook/core": ["./packages/writer-notebook/src/core/index.ts"],
      "writer-notebook/browser": ["./packages/writer-notebook/src/browser/index.ts"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src",
    "packages/writer-sync/src",
    "packages/writer-sync/test",
    "packages/writer-qr/src",
    "packages/writer-qr/test",
    "packages/writer-notebook/src",
    "packages/writer-notebook/test"
  ]
}
