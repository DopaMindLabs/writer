# Warn (never block) when a branch with a non-conforming name is checked out.
# Git passes: $1 previous HEAD, $2 new HEAD, $3 flag (1 = branch checkout).
# Skip file checkouts ($3 != 1); git ignores this hook's exit code regardless.
if [ "$3" = "1" ]; then
  node scripts/validate-branch-name.mjs --warn
fi
